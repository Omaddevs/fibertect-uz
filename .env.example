# Shu faylni .env nomi bilan nusxalang va qiymatlarni o'zgartiring. .env faylini hech kimga bermang.

# Admin panel paroli (kamida 10 belgi, majburiy)
ADMIN_PASSWORD=

# Server porti
PORT=8787

# production: kirish cookie'si faqat HTTPS orqali yuboriladi
NODE_ENV=production

# Nginx, Caddy yoki Cloudflare ortida ishlasa 1 qiling: mamlakat haqiqiy IP dan aniqlanadi.
# Proksi bo'lmasa 0 qoldiring, aks holda IP sarlavhasini soxtalashtirish mumkin.
TRUST_PROXY=0

# Yangi arizalar shu Telegram chatiga keladi (ixtiyoriy). Bo'sh bo'lsa arizalar faqat admin panelda ko'rinadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Saytning asosiy manzili (sitemap.xml va robots.txt uchun)
SITE_URL=https://fibertech.uz
